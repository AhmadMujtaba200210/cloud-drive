# Copy to .env and fill. .env is git-ignored. Never commit real keys.
LAUNCHSHIELD_GROQ_API_KEY=
LAUNCHSHIELD_GEMINI_API_KEY=
LAUNCHSHIELD_OPENROUTER_API_KEY=
# Free local stack (scripts/local_search_stack.sh start). Leave FIRECRAWL_API_KEY empty.
SEARXNG_URL=http://127.0.0.1:8888
FIRECRAWL_BASE_URL=http://127.0.0.1:3002
# Only for Firecrawl Cloud instead of local:
FIRECRAWL_API_KEY=
# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.5-flash-lite      # only *-flash-lite models are accepted
# GEMINI_LITE_MODEL=gemini-3.1-flash-lite
# OPENROUTER_MODEL=openai/gpt-oss-120b
# OPENROUTER_FREE_MODEL=openrouter/free
# DEEP_SEARCH_COUNTRIES=PK,AE,JP,DE,GB,US,CN,TH,MY,SA,TR,KR
# DISABLE_DEEP_SEARCH=1
# FX_LIVE=1
# DEEP_SEARCH_BUDGET_S=170              # hard time budget per research run
# DEEP_SEARCH_FOLLOW_PER_COUNTRY=4      # product pages opened from listing pages
# MAX_CONCURRENT_SEARCHES=3
# DISABLE_DOCS=1                        # hide /docs in production

# Oracle Autonomous Database knowledge base (cuts AI calls). On the server, run: sudo deploy/oracle_setup.sh
# ORACLE_DB_USER=PARTSBRIDGE_APP
# ORACLE_DB_PASSWORD=
# ORACLE_DB_DSN=<dbname>_tp
# ORACLE_WALLET_DIR=/etc/partsbridge/oracle-wallet
# ORACLE_WALLET_PASSWORD=
# KB_MODEL_DIR=/opt/partsbridge/.cache/fastembed
# KB_DISABLED=1

# Extra search providers (optional). Keys live only in /etc/partsbridge/env on the server.
# NIMBLE_API_KEY=            # real Google results, localized (sdk.nimbleway.com/v2/serp)
# TAVILY_API_KEY=            # Tavily search API
# NIMBLE_DAILY_CAP=160       # ~4,800/month: stays inside Nimble's 5,000 free calls
# TAVILY_DAILY_CAP=30        # ~900/month: stays inside Tavily's 1,000 free credits
# NIMBLE_PER_MINUTE=60
# TAVILY_PER_MINUTE=60
